<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="realestate_contract_sale_form" model="ir.ui.view">
        <field name="name">realestate.contract.sale.form</field>
        <field name="inherit_id" ref="real_estate_nacho.realestate_contract_form_view"/>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_orders" type="object" class="oe_state_button" icon="fa-shopping-cart">
                    <field name="order_count" widget="statinfo" string="Orders"/>
                </button>
            </div>
            <field name="property_id" position="after">
                <field name="product_id"/>
            </field>
            <button name="action_progress" position="after">
                <button name="action_create_sale_order" type="object" string="Create Order" class="btn-primary"/>
                <button name="action_confirm_and_invoice" type="object" string="Confirm and Invoice" class="btn-primary"/>
             </button>
        </field>
    </record>
</odoo>