<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="realestate_contract_cron_finish" model="ir.cron">
        <field name="name">Real Estate: finish contracts with end date passed</field>
        <field name="model_id" ref="model_realestate_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_finish_contracts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="realestate_visit_cron_finish" model="ir.cron">
        <field name="name">Real Estate: finish scheduled visits with date passed</field>
        <field name="model_id" ref="model_realestate_visit"/>
        <field name="state">code</field>
        <field name="code">model._cron_finish_visits()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

</odoo>
