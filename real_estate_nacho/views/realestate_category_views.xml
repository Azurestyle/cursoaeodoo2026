<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<record id="realestate_category_action" model="ir.actions.act_window">
    <field name="name">Categories</field>
    <field name="res_model">realestate.category</field>
    <field name="view_mode">list,form</field>
</record>

<record id="realestate_category_list" model="ir.ui.view">
    <field name="name">realestate.category.list</field>
    <field name="model">realestate.category</field>
    <field name="arch" type="xml">
        <list string="Categories">
            <field name="name" optional="show"/>
            <field name="description" optional="show"/>
        </list>
    </field>
</record>

<record id="realestate_category_form" model="ir.ui.view">
    <field name="name">realestate.category.form</field>
    <field name="model">realestate.category</field>
    <field name="arch" type="xml">
        <form string="Category">
            <sheet>
            <div class="oe_title">
                <h1>
                    <field name="name"/>
                </h1>
            </div>
                <group>
                    <field name="description"/>
                </group>
            </sheet>
        </form>
    </field>
</record>
</odoo>