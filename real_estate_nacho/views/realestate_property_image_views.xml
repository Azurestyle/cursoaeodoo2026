<?xml version="1.0" encoding="UTF-8"?>
<odoo>

<record id="realestate_property_image_action" model="ir.actions.act_window">
    <field name="name">Property Images</field>
    <field name="res_model">realestate.property.image</field>
    <field name="view_mode">list,form</field>
</record>

<record id="realestate_property_image_list_view" model="ir.ui.view">
    <field name="name">realestate.property.image.list</field>
    <field name="model">realestate.property.image</field>
    <field name="arch" type="xml">
        <list string="Property Images">
            <field name="sequence" widget="handle"/>
            <field name="name"/>
            <field name="image" widget="image"/>
            <field name="property_id" options="{'no_open': True, 'no_create': True}"/>
        </list>
    </field>
</record>

<record id="realestate_property_image_form_view" model="ir.ui.view">
    <field name="name">realestate.property.image.form</field>
    <field name="model">realestate.property.image</field>
    <field name="arch" type="xml">
        <form string="Property Image">
            <sheet>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="property_id" options="{'no_open': True, 'no_create': True}"/>
                    </group>
                    <group>
                        <field name="sequence"/>
                    </group>
                </group>
                <field name="image" widget="image"/>
            </sheet>
        </form>
    </field>
</record>

</odoo>
