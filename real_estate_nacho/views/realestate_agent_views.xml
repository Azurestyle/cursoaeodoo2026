<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="realestate_agent_action" model="ir.actions.act_window">
    <field name="name">Agents</field>
    <field name="res_model">realestate.agent</field>
    <field name="view_mode">list,form</field>
</record>

<record id="realestate_agent_list_view" model="ir.ui.view">
    <field name="name">realestate.agent.list</field>
    <field name="model">realestate.agent</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="phone"/>
            <field name="email"/>
            <field name="commission_pct"/>
        </list>
    </field>
</record>

<record id="realestate_agent_form_view" model="ir.ui.view">
    <field name="name">realestate.agent.form</field>
    <field name="model">realestate.agent</field>
    <field name="arch" type="xml">
        <form string="Agent">
            <sheet>
                <div class="oe_title">
                    <h1>
                        <field name="name" placeholder="Agent Name"/>
                    </h1>
                </div>
                <group>
                    <group>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="commission_pct"/>
                    </group>
                    <group>
                        <field name="street"/>
                        <field name="city"/>
                        <field name="country_id"/>
                    </group>
                </group>
            </sheet>
        </form>
    </field>
</record>

</odoo>
