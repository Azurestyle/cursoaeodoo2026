<?xml version="1.0" encoding="UTF-8"?>
<odoo>

<record id="realestate_contract_action" model="ir.actions.act_window">
    <field name="name">realestate.contract.action</field>
    <field name="res_model">realestate.contract</field>
    <field name="view_mode">list,form</field>
</record>

<record id="realestate_contract_list_view" model="ir.ui.view">
    <field name="name">realestate.contract.list.view</field>
    <field name="model">realestate.contract</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="contract_type"/>
            <field name="property_id"/>
            <field name="partner_id"/>
            <field name="start_date"/>
            <field name="end_date"/>
            <field name="days_in_progress"/>
            <field name="rent"/>
            <field name="deposit"/>
            <field name="state" optional="show"/>
        </list>
    </field>
</record>

<record id="realestate_contract_form_view" model="ir.ui.view">
    <field name="name">realestate.contract.form.view</field>
    <field name="model">realestate.contract</field>
    <field name="arch" type="xml">
     <form string="Contract">
        <header>
            <button name="action_draft" class="btn-secondary" string="Reset to Draft" invisible="state == 'draft'" type="object" />
            <button name="action_progress" class="btn-primary" string="Set to Progress" invisible="state != 'draft'" type="object" />
            <button name="action_done" class="btn-success" string="Set to Done" invisible="state != 'progress'" type="object" />
            <button name="action_cancelled" class="btn-danger" string="Set to Cancelled" invisible="state == 'cancelled'" type="object" />
            <field name="state" widget="statusbar"/>
        </header>
    
            <sheet>
            <div class="oe_title">
            <h1>
                <field name="name" placeholder="Contract Name"/>
            </h1>
            </div>
            <group>
                <group>
                 <field name="partner_id"/>
                 <field name="contract_type"/>
                 <field name="property_id"/>
                 <field name="has_deposit"/>
                </group>

                <group>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="duration_days"/>
                    <field name="days_to_end"/>
                    <field name="days_in_progress"/>
                    <field name="rent"/>
                    <field name="deposit"/>
                </group> 
            </group>
            </sheet>
        </form>
    </field>
</record>
</odoo>
