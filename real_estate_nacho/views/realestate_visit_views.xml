<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="realestate_visit_action" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">realestate.visit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
        Create a new visit
        </p>
        <p>
        Fill in the details of the visit you want to add, such as the property, visitor, and date.
        </p>
    </field>
    </record>

    <record id="realestate_visit_tree_view" model="ir.ui.view">
        <field name="name">realestate.visit.list</field>
        <field name="model">realestate.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id" optional="hide"/>
                <field name="date" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="realestate_visit_form_view" model="ir.ui.view">
        <field name="name">realestate.visit.form</field>
        <field name="model">realestate.visit</field>
        <field name="arch" type="xml">
            <form>
            <header>
            <button name="action_draft" invisible="state not in ('done','canceled')" string="Set to Draft" type="object" class="btn-secondary"/>
            <button name="action_schedule" invisible="state in ('scheduled','done','canceled')" string="Schedule" type="object" class="btn-primary"/>
            <button name="action_done" invisible="state in ('draft','done','canceled')" string="Done" type="object" class="btn-success"/>
            <button name="action_cancel" invisible="state in ('canceled')" string="Cancel" type="object" class="btn-danger"/>
            <field name="state" options="{'clickable': True}" widget="statusbar"/>
            </header>
                <sheet>
                <widget name="web_ribbon" invisible="state != 'canceled'" title="Canceled" bg_color="text-bg-danger"/>
                <group>
                    <group>
                        <field name="property_id"/>
                        <field name="user_id"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="partner_id"/>
                    </group>
                </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>