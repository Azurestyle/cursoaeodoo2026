<?xml version="1.0" encoding="UTF-8"?>

<odoo>


<record id="realestate_property_tag_action" model="ir.actions.act_window">
    <field name="name">Property Tags</field>
    <field name="res_model">realestate.property.tag</field>
    <field name="view_mode">list,form</field>
</record>

<record id="realestate_property_tag_list_view" model="ir.ui.view">
    <field name="name">realestate.property.tag.list</field>
    <field name="model">realestate.property.tag</field>
    <field name="arch" type="xml">
        <list string="Property Tags">
            <field name="name"/>
            <field name="color" widget="color_picker"/>
        </list>
    </field>
</record>

<record id="realestate_property_tag_form_view" model="ir.ui.view">
    <field name="name">realestate.property.tag.form</field>
    <field name="model">realestate.property.tag</field>
    <field name="arch" type="xml">
        <form string="Property Tag">
            <sheet>
                <div class="oe_title">
                <h1>
                    <field name="name" placeholder="Tag Name"/>
                </h1>
                </div>
                <group>
                    <field name="color" widget="color_picker"/>
                </group>
                <field name="property_ids"/>
            </sheet>
        </form>
    </field>
</record>
</odoo>