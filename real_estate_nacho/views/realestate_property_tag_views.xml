<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="realestate_property_tag_action" model="ir.actions.act_window">
    <field name="name">Tags</field>
    <field name="res_model">realestate.property.tag</field>
    <field name="view_mode">list,form</field>
</record>

<record id="realestate_property_tag_view_list" model="ir.ui.view">
    <field name="name">realestate.property.tag.view.list</field>
    <field name="model">realestate.property.tag</field>
    <field name="arch" type="xml">
        <list string="Tags">
            <field name="name"/>
            <field name="color" widget="color_picker"/>
        </list>
    </field>
</record>

<record id="realestate_property_tag_view_form" model="ir.ui.view">
    <field name="name">realestate.property.tag.view.form</field>
    <field name="model">realestate.property.tag</field>
    <field name="arch" type="xml">
        <form string="Tag">
            <sheet>
                <div class="oe_title">
                    <h1>
                        <field name="name" placeholder="Tag Name"/>
                    </h1>
                </div>
                <group>
                    <field name="color" widget="color_picker"/>
                </group>
            </sheet>
        </form>
    </field>
</record>
</odoo>
