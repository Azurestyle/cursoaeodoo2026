<?xml version="1.0" encoding="UTF-8"?>
<odoo>

<record id="realestate_property_action" model="ir.actions.act_window">
    <field name="name">Properties</field>
    <field name="res_model">realestate.property</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
        Create a new property
        </p>
        <p>
        Fill in the details of the property you want to add, such as its name and description.
        </p>
    </field>
</record>

<record id="realestate_property_list_view" model="ir.ui.view">
    <field name="name">realestate.property.list</field>
    <field name="model">realestate.property</field>
    <field name="arch" type="xml">
        <list string="Properties" multi_edit="1">
            <field name="reference" optional="show"/>
            <field name="name" optional="show"/>
            <field name="description" optional="hide"/>
            <field name="price" optional="show"/>
            <field name="availability" widget="boolean_toggle" optional="show"/>
            <field name="user_id" widget="many2one_avatar_user" optional="show"/>
        </list>
    </field>
</record>

<record id="realestate_property_form_view" model="ir.ui.view">
    <field name="name">realestate.property.form</field>
    <field name="model">realestate.property</field>
    <field name="arch" type="xml">
        <form string="Property">
            <sheet>
                <div class="oe_title">
                    <h1>
                        <field name="name" placeholder="Property Name"/>
                    </h1>
                </div>
                <group>
                    <group>
                        <field name="reference"/>
                        <field name="price"/>
                    </group>
                    <group>
                        <field name="availability" widget="boolean_toggle"/>
                        <field name="user_id" widget="many2one_avatar_user"/>
                    </group>
                </group>
                <notebook>
                    <page string="Information">
                        <field name="description"/>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>
</odoo>