<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="realestate_partner_wizard_action" model="ir.actions.act_window">
        <field name="name">Create Partner</field>
        <field name="res_model">realestate.partner.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
    </record>


    <record id="realestate_partner_wizard_view_form" model="ir.ui.view">
        <field name="model">realestate.partner.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Real Estate Partner">
                <group>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="street"/>
                    <field name="city"/>
                    <field name="category_id" widget="many2many_tags"/>
                </group>
                <footer>
                    <button string="Create" type="object" name="action_create_partner" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_realestate_partner_wizard" name="Create Partner" parent="contacts.menu_contacts" action="realestate_partner_wizard_action"/>
</odoo>