<?xml version="1.0" encoding="UTF-8"?>

<odoo>
<record id="realestate_property_schedule_visits_action" model="ir.actions.act_window">
    <field name="name">Schedule Property Visits</field>
    <field name="res_model">realestate.property.schedule.visits</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="real_estate_nacho.model_realestate_property"/>
    <field name="binding_view_types">form</field>
</record>

<record id="realestate_property_schedule_visits_form_view" model="ir.ui.view">
    <field name="name">realestate.property.schedule.visits.form</field>
    <field name="model">realestate.property.schedule.visits</field>
    <field name="arch" type="xml">
        <form string="Schedule Property Visits">
                <group>
                    <field name="start_date" widget="daterange" options="{'end_date_field': 'end_date'}"/>
                    <field name="end_date" widget="daterange" invisible="1"/>
                </group>
                <footer>
                    <button string="Schedule" name="action_create_visits" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
        </form>
    </field>
</record>
</odoo>