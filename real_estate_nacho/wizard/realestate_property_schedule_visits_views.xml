<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="realestate_property_schedule_visits_action" model="ir.actions.act_window">
    <field name="name">Schedule Visits</field>
    <field name="res_model">realestate.property.schedule.visits</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="context">{"default_property_id": active_id}</field>
    <field name="binding_model_id" ref="real_estate_nacho.model_realestate_property"/>
    <field name="binding_view_types">form</field>
</record>

<record id="realestate_property_schedule_visits_view_form" model="ir.ui.view">
    <field name="name">realestate.property.schedule.visits.view.form</field>
    <field name="model">realestate.property.schedule.visits</field>
    <field name="arch" type="xml">
        <form string="Schedule Visits">
            <group>
                <field name="property_id"/>
                <field name="start_date" widget="daterange" options="{'end_date_field': 'end_date'}"/>
                <field name="end_date" widget="daterange" invisible="1"/>
            </group>
            <footer>
                <button string="Create Visits" name="action_create_visits" type="object" class="btn-primary"/>
                <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>
</odoo>
