<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   <record id="realestate_visit_change_state_action" model="ir.actions.act_window">
       <field name="name">Change State of Real Estate Visit</field>
       <field name="res_model">realestate.visit.change.state</field>
       <field name="view_mode">form</field>
       <field name="target">new</field>
       <field name="binding_model_id" ref="model_realestate_visit"/>
       <field name="binding_view_types">list</field>
   </record>


   <record id="view_realestate_visit_change_state_form" model="ir.ui.view">
       <field name="name">realestate.visit.change.state.form</field>
       <field name="model">realestate.visit.change.state</field>
       <field name="arch" type="xml">
           <form string="Change State of Real Estate Visit">
               <group>
                   <field name="state"/>
               </group>
               <footer>
                   <button string="Change State" type="object" name="action_change_state" class="btn-primary"/>
                   <button string="Cancel" class="btn-secondary" special="cancel"/>
               </footer>
           </form>
       </field>
   </record>
</odoo>
