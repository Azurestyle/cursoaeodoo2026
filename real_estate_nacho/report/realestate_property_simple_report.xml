<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_realestate_property_simple" model="ir.actions.report">
        <field name="name">Property Simplified</field>
        <field name="model">realestate.property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_nacho.report_realestate_property_simple</field>
        <field name="report_file">real_estate_nacho.report_realestate_property_simple</field>
        <field name="print_report_name">'Properties'</field>
        <field name="binding_model_id" ref="model_realestate_property"/>
        <field name="binding_type">report</field>
    </record>

   <template id="report_realestate_property_simple">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
        <div class="page">
            <h2>Properties</h2>
            <table class="table table-sm o_main_table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Reference</th>
                    <th class="text-end">Price</th>
                    <th>Stage</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="docs" t-as="o">
                    <td><span t-field="o.name"/></td>
                    <td><span t-field="o.reference"/></td>
                    <td class="text-end"><span t-field="o.price"/></td>
                    <td><span t-field="o.stage_id"/></td>
                </tr>
            </tbody>
            </table>
        </div>
        </t>
    </t>
   </template>
</odoo>