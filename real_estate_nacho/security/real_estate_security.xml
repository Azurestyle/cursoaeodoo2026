<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

    <record model="ir.module.category" id="module_category_real_estate">
        <field name="name">Real Estate</field>
        <field name="sequence">10</field>
    </record>
    <record model="res.groups.privilege" id="res_groups_privilege_real_estate">
        <field name="name">Real Estate</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_real_estate"/>
    </record>
    <record model="res.groups" id="group_real_estate_user">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_real_estate"/>
        <field name="comment">Real Estate User Group</field>
    </record>
    <record model="res.groups" id="group_real_estate_manager">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('group_real_estate_user'))]"/>
        <field name="comment">Real Estate Manager Group</field>
    </record>

    <record model="ir.rule" id="real_estate_rule_user">
        <field name="name">Personal Properties</field>
        <field name="model_id" ref="model_realestate_property"/>
        <field name="domain_force">['|',('user_id','=',user.id),('user_id','=',False)]</field>
        <field name="groups" eval="[(4, ref('group_real_estate_user'))]"/>
    </record>

    <record model="ir.rule" id="real_estate_rule_manager">
        <field name="name">All Properties</field>
        <field name="model_id" ref="model_realestate_property"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_real_estate_manager'))]"/>
    </record>

    </data>
</odoo>